# Supabase Auth (public browser configuration only; never a service-role key)
NEXT_PUBLIC_SUPABASE_URL=
# Legacy name for the browser-safe key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Newer Supabase projects issue a publishable key (sb_publishable_...);
# it is the same browser-safe credential role, so either name resolves:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
