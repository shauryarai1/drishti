# Server-only secrets. Never expose these to the frontend.
GEMINI_API_KEY=
NVIDIA_API_KEY=

# Place autocomplete provider (server-side only; never NEXT_PUBLIC_*).
# Geoapify free plan: 3,000 credits/day, up to 5 requests/second.
GEOAPIFY_API_KEY=

# Optional provider tuning (names only).
NVIDIA_MODELS=
KAVACH_LOG_LEVEL=

# Owner archive (product_submissions / admin_users) via Supabase.
# SUPABASE_URL is the project URL; the service-role key is server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dev tooling is fail-closed: /api/dev/* is served only when the dev-tools
# flag is set, or by default to loopback callers. Never enable it in
# production. Setting the rate-limit flag to 0 disables the limiter (tests only).
KAVACH_DEV_TOOLS=
KAVACH_RATELIMIT=
